# Generate with: openssl rand -hex 32
BROKER_TOKEN=replace-with-at-least-32-random-characters
ADMIN_PASSWORD=replace-with-the-palworld-rest-api-password
# Docker socket group on the host (`stat -c %g /var/run/docker.sock`).
DOCKER_GID=999
# Comma-separated exact container names the broker may control.
PALWORLD_CONTAINERS=palworld-server
